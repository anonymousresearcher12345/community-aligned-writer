# Export these settings before starting Python or submitting a job.
CA_CONFIG_PATH=""
# Comma-separated account names; the first fetches the small feed.
CA_API_ACCOUNTS=""
# Optional executable override; empty uses xurl on PATH.
XURL_BIN=""
GEMINI_API_KEY=""
XAI_API_KEY=""
OPENAI_API_KEY=""
BERT_CKPT=""
D6_RATER_TSV=""
D2_HELPFULNESS_TSV=""
# For Slurm submissions outside the repository root; empty uses SLURM_SUBMIT_DIR.
CA_PROJECT_ROOT=""
# Optional interpreter override; empty uses python from the active environment.
PYTHON_BIN=""
